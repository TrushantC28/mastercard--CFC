# Server Configuration
PORT=8000
# Allowed frontend origins (comma-separated for multiple, e.g., http://localhost:5173,https://mastercard-cfc.vercel.app)
CORS_ORIGIN=https://mastercard-cfc.vercel.app

# Database Configuration
DB_NAME=mastercard_cfc
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net

# JWT Configuration
ACCESS_TOKEN_SECRET=<64-char-random-string>
ACCESS_TOKEN_EXPIRY=15m          # Short-lived access token
REFRESH_TOKEN_SECRET=<64-char-random-string>
REFRESH_TOKEN_EXPIRY=10d         # Long-lived refresh token

# Cloudinary (for file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
